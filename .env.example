# ==========================================
# GramVikas — Environment Configuration
# ==========================================

# 1. Supabase Cloud Database & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Groq AI LLM API (Llama 3.3 70B Versatile)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Fast2SMS API Key (Emergency SOS SMS Dispatch)
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# 4. Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
